+class VisionSwap(unittest.TestCase):
+    """Ulmus swap mode: a new image is encoded inside one engine LEND ... RECLAIM, between LOAD and UNLOAD."""
+
+    ENCODER = r"""
+import sys
+print("READY 8", flush=True)
+for line in sys.stdin:
+    w = line.split()
+    if not w or w[0] == "QUIT":
+        break
+    if w[0] == "UNLOAD":
+        print("UNLOADED 6.0 1500", flush=True)
+    elif w[0] == "LOAD":
+        print("ERR cannot load" if "fail-load" in sys.argv else "LOADED 120.0", flush=True)
+    elif w[0] == "ENC":
+        open(w[2], "wb").write(b"rows")
+        print("OK 3 3 1 5", flush=True)
+"""
+
+    class Engine:
+        def __init__(self, log):
+            self.log = log
+
+        def alive(self):
+            return True
+
+        def lend_vram(self, reclaim=False, need_mib=0):
+            self.log.append("RECLAIM" if reclaim else "LEND")
+            assert reclaim or need_mib == 1500 + SWAP_MARGIN_MIB
+            return "RECLAIMED 1 1 1" if reclaim else "LENT 1 1 1"
+
+    def vision(self, d, mmproj="m.gguf"):
+        script = Path(d) / "encoder.py"
+        script.write_text("#!" + sys.executable + "\n" + self.ENCODER)
+        script.chmod(0o755)
+        return Vision({"exe": str(script), "mmproj": mmproj, "model": "m", "swap": True})
+
+    def test_new_images_borrow_once_and_cached_images_do_not(self):
+        import tempfile
+        with tempfile.TemporaryDirectory() as d:
+            v = self.vision(d)
+            self.assertEqual(v.lend_mib, 1500 + SWAP_MARGIN_MIB)
+            self.assertFalse(v.loaded)
+            log = []
+            a, b = (Path(d) / "a.png", Path(d) / "b.png")
+            a.write_bytes(b"\x89PNG\r\n\x1a\nA")
+            b.write_bytes(b"\x89PNG\r\n\x1a\nB")
+            out = v.encode_all([str(a), str(b), str(a)], self.Engine(log))
+            self.assertEqual([n for _, n in out], [3, 3, 3])
+            self.assertEqual(log, ["LEND", "RECLAIM"])
+            self.assertFalse(v.loaded)
+            v.encode_all([str(b)], self.Engine(log))
+            self.assertEqual(log, ["LEND", "RECLAIM"])          # cached: nothing borrowed
+            v.close()
+
+    def test_a_failed_load_gives_the_vram_back(self):
+        import tempfile
+        with tempfile.TemporaryDirectory() as d:
+            v = self.vision(d, mmproj="fail-load")
+            log = []
+            img = Path(d) / "c.png"
+            img.write_bytes(b"\x89PNG\r\n\x1a\nC")
+            with self.assertRaises(ValueError):
+                v.encode_all([str(img)], self.Engine(log))
+            self.assertEqual(log, ["LEND", "RECLAIM"])
+            v.close()
+
+
