+    int dev = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess) {
+        err = "ExpertCache: cudaGetDevice failed";
+        return false;
+    }
+    const CUmemAllocationProp prop = device_prop(dev);
+    size_t gran = 0;
+    CUresult r = v.granularity(&gran, &prop, CU_MEM_ALLOC_GRANULARITY_RECOMMENDED);
+    if (r != CUDA_SUCCESS || gran == 0) {
+        err = cu_failed("cuMemGetAllocationGranularity", r);
+        return false;
+    }
+    // 64 MiB chunks: a lend hands back only what the borrower is short of, at a few dozen driver calls at most
+    const uint64_t chunk = (((uint64_t) 64 << 20) + gran - 1) / gran * gran;
+    const uint64_t n_chunks = ((uint64_t) lend_want_ + chunk - 1) / chunk;
+    const uint64_t tail = n_chunks * chunk;
+    const uint64_t total = std::max<uint64_t>((want + gran - 1) / gran * gran, tail + gran);
+    if (tail + gran > (want + gran - 1) / gran * gran) {
+        char buf[200];
+        std::snprintf(buf, sizeof buf, "ExpertCache: a lendable tail of %.0f MiB does not fit in a %.0f MiB cache",
+                      (double) tail / 1048576.0, (double) want / 1048576.0);
+        err = buf;
+        return false;
+    }
+    const uint64_t main = total - tail;
+    const CUmemAccessDesc rw = device_rw(dev);
+    CUdeviceptr va = 0;
+    CUmemGenericAllocationHandle hm = 0;
+    std::vector<unsigned long long> hc((size_t) n_chunks, 0);
+    bool reserved = false, main_mapped = false;
+    size_t mapped_chunks = 0;
+    const char* step = "cuMemAddressReserve";
+    if ((r = v.reserve(&va, total, gran, 0, 0)) == CUDA_SUCCESS) {
+        reserved = true;
+        step = "cuMemCreate (cache)";
+        if ((r = v.create(&hm, main, &prop, 0)) == CUDA_SUCCESS) {
+            step = "cuMemMap (cache)";
+            if ((r = v.map(va, main, 0, hm, 0)) == CUDA_SUCCESS) {
+                main_mapped = true;
+                for (size_t j = 0; j < hc.size() && r == CUDA_SUCCESS; ++j) {
+                    CUmemGenericAllocationHandle h = 0;
+                    step = "cuMemCreate (lendable tail)";
+                    if ((r = v.create(&h, chunk, &prop, 0)) != CUDA_SUCCESS) break;
+                    hc[j] = h;
+                    step = "cuMemMap (lendable tail)";
+                    if ((r = v.map(va + main + j * chunk, chunk, 0, h, 0)) == CUDA_SUCCESS) ++mapped_chunks;
+                }
+                if (r == CUDA_SUCCESS) {
+                    step = "cuMemSetAccess";
+                    r = v.set_access(va, total, &rw, 1);
+                }
+            }
+        }
+    }
+    if (r != CUDA_SUCCESS) {
+        for (size_t j = 0; j < mapped_chunks; ++j) v.unmap(va + main + j * chunk, chunk);
+        for (const unsigned long long h : hc)
+            if (h) v.release(h);
+        if (main_mapped) v.unmap(va, main);
+        if (hm) v.release(hm);
+        if (reserved) v.free_va(va, total);
+        err = cu_failed(step, r) + " for a " + std::to_string((long long) (total >> 20)) + " MiB cache";
+        return false;
+    }
+    base_ = reinterpret_cast<uint8_t*>(va);
+    vmm_ = true;
+    va_bytes_ = total;
+    main_bytes_ = main;
+    chunk_bytes_ = (int64_t) chunk;
+    h_main_ = hm;
+    h_chunks_ = std::move(hc);
+    lent_chunks_ = 0;
+    tail_lent_ = false;
+    return true;
+#endif
+}
+
+void ExpertCache::close_vmm() {
+#if !defined(STRATA_USE_HIP)
+    const Vmm& v = vmm();
+    const CUdeviceptr va = reinterpret_cast<CUdeviceptr>(base_);
+    cudaDeviceSynchronize();
+    for (size_t j = 0; j < h_chunks_.size(); ++j)
+        if (h_chunks_[j]) {
+            v.unmap(va + (CUdeviceptr) (main_bytes_ + j * (uint64_t) chunk_bytes_), (size_t) chunk_bytes_);
+            v.release(h_chunks_[j]);
+        }
+    if (h_main_) {
+        v.unmap(va, (size_t) main_bytes_);
+        v.release(h_main_);
+    }
+    v.free_va(va, (size_t) va_bytes_);
+#endif
+    vmm_ = false;
+    tail_lent_ = false;
+    lent_chunks_ = 0;
+    va_bytes_ = 0;
+    main_bytes_ = 0;
+    chunk_bytes_ = 0;
+    h_main_ = 0;
+    h_chunks_.clear();
+}
+
+int32_t ExpertCache::first_slot_ending_after(uint64_t offset) const {
+    if (!off_.empty()) {   // the first slot whose end lies past `offset`
+        const auto it = std::upper_bound(off_.begin() + 1, off_.end(), offset);
+        return (int32_t) std::min<int64_t>((int64_t) (it - off_.begin()) - 1, slots_);
+    }
+    return (int32_t) std::min<int64_t>((int64_t) offset / blob_, slots_);
+}
+
+int32_t ExpertCache::first_slot_for_lend(int64_t bytes) const {
+    if (!vmm_ || h_chunks_.empty() || bytes <= 0) return (int32_t) slots_;
+    const int64_t k = std::min<int64_t>((bytes + chunk_bytes_ - 1) / chunk_bytes_, (int64_t) h_chunks_.size());
+    return first_slot_ending_after(va_bytes_ - (uint64_t) (k * chunk_bytes_));
+}
+
+int32_t ExpertCache::first_lent_slot() const {
+    if (!tail_lent_ || lent_chunks_ <= 0) return (int32_t) slots_;
+    return first_slot_ending_after(va_bytes_ - (uint64_t) (lent_chunks_ * chunk_bytes_));
+}
+
+bool ExpertCache::lend_tail(int64_t bytes, std::string& err) {
+#if defined(STRATA_USE_HIP)
+    (void) bytes;
+    err = "ExpertCache: nothing to lend in a HIP build";
+    return false;
+#else
+    if (!vmm_ || h_chunks_.empty()) { err = "ExpertCache: no lendable tail (--lend-vram-mib)"; return false; }
+    if (tail_lent_) { err = "ExpertCache: the tail is already lent"; return false; }
+    const int64_t n = (int64_t) h_chunks_.size();
+    const int64_t k = bytes <= 0 ? 0 : std::min<int64_t>((bytes + chunk_bytes_ - 1) / chunk_bytes_, n);
+    const cudaError_t s = cudaDeviceSynchronize();   // nothing may still read or write the lent chunks
+    if (s != cudaSuccess) { err = std::string("ExpertCache: lend: ") + cudaGetErrorString(s); return false; }
+    const Vmm& v = vmm();
+    tail_lent_ = true;
+    lent_chunks_ = 0;
+    for (int64_t j = n - 1; j >= n - k; --j) {   // from the end, so what is lent is always one suffix
+        const CUdeviceptr at = reinterpret_cast<CUdeviceptr>(base_) + (CUdeviceptr) (main_bytes_ + (uint64_t) j * chunk_bytes_);
+        CUresult r = v.unmap(at, (size_t) chunk_bytes_);
+        if (r != CUDA_SUCCESS) {
+            err = cu_failed("cuMemUnmap (lend)", r);
+            if (lent_chunks_ == 0) tail_lent_ = false;   // nothing handed back: not lent at all
+            return false;
+        }
+        ++lent_chunks_;
+        r = v.release(h_chunks_[(size_t) j]);
+        h_chunks_[(size_t) j] = 0;
+        if (r != CUDA_SUCCESS) { err = cu_failed("cuMemRelease (lend)", r); return false; }
+    }
+    return true;
+#endif
+}
+
+bool ExpertCache::reclaim_tail(std::string& err) {
+#if defined(STRATA_USE_HIP)
+    err = "ExpertCache: nothing to reclaim in a HIP build";
+    return false;
+#else
+    if (!vmm_ || !tail_lent_) { err = "ExpertCache: the tail is not lent"; return false; }
+    int dev = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess) { err = "ExpertCache: cudaGetDevice failed"; return false; }
+    const Vmm& v = vmm();
+    const CUmemAllocationProp prop = device_prop(dev);
+    const CUmemAccessDesc rw = device_rw(dev);
+    using Ms = std::chrono::duration<double, std::milli>;
+    reclaim_ms_[0] = reclaim_ms_[1] = reclaim_ms_[2] = 0.0;
+    const int64_t n = (int64_t) h_chunks_.size();
+    for (int64_t j = n - lent_chunks_; j < n; ++j) {   // the lent suffix, lowest address first
+        const CUdeviceptr at = reinterpret_cast<CUdeviceptr>(base_) + (CUdeviceptr) (main_bytes_ + (uint64_t) j * chunk_bytes_);
+        CUmemGenericAllocationHandle h = 0;
+        auto t = std::chrono::steady_clock::now();
+        CUresult r = v.create(&h, (size_t) chunk_bytes_, &prop, 0);
+        if (r != CUDA_SUCCESS) {   // [j, n) stays lent: still one suffix
+            lent_chunks_ = n - j;
+            err = cu_failed("cuMemCreate (reclaim)", r);
+            return false;
+        }
+        auto t1 = std::chrono::steady_clock::now();
+        if ((r = v.map(at, (size_t) chunk_bytes_, 0, h, 0)) != CUDA_SUCCESS) {
+            v.release(h);
+            lent_chunks_ = n - j;
+            err = cu_failed("cuMemMap (reclaim)", r);
+            return false;
+        }
+        auto t2 = std::chrono::steady_clock::now();
+        if ((r = v.set_access(at, (size_t) chunk_bytes_, &rw, 1)) != CUDA_SUCCESS) {
+            v.unmap(at, (size_t) chunk_bytes_);
+            v.release(h);
+            lent_chunks_ = n - j;
+            err = cu_failed("cuMemSetAccess (reclaim)", r);
+            return false;
+        }
+        reclaim_ms_[0] += Ms(t1 - t).count();
+        reclaim_ms_[1] += Ms(t2 - t1).count();
+        reclaim_ms_[2] += Ms(std::chrono::steady_clock::now() - t2).count();
+        h_chunks_[(size_t) j] = h;
+    }
+    lent_chunks_ = 0;
+    tail_lent_ = false;
+    return true;
+#endif
+}
