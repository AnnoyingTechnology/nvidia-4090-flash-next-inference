diff --git a/src/core/expert_cache.cpp b/src/core/expert_cache.cpp
--- a/src/core/expert_cache.cpp
+++ b/src/core/expert_cache.cpp
@@ -280,11 +280,21 @@ bool ExpertCache::fill_slot(int32_t slot, const uint8_t* host_blob, void* stream, std
 
 bool copy_blobs(void* const* dst, const void* const* src, const size_t* bytes, size_t n, void* stream) {
     if (n == 0) return true;
+#if CUDART_VERSION >= 13000
     cudaMemcpyAttributes attr{};
     attr.srcAccessOrder = cudaMemcpySrcAccessOrderStream;
     attr.flags = cudaMemcpyFlagPreferOverlapWithCompute;   // the copy engines, beside the kernels
     size_t first = 0;
     return cudaMemcpyBatchAsync(dst, src, bytes, n, &attr, &first, 1, (cudaStream_t) stream) == cudaSuccess;
+#else
+    // The source is live until this stream completes, as with srcAccessOrderStream.
+    // UVA chooses H2D/D2D/peer direction; preserve the caller's stream dependencies.
+    for (size_t i = 0; i < n; ++i) {
+        if (cudaMemcpyAsync(dst[i], src[i], bytes[i], cudaMemcpyDefault,
+                            (cudaStream_t) stream) != cudaSuccess) return false;
+    }
+    return true;
+#endif
 }
 
